{
  "name": "delisert.mks-1",
  "private": true,
  "overrides": {
    "@effect/platform-node-shared": "4.0.6"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.18.0",
      "libsql": "0.5.29",
      "@trpc/server": "^11.19.0",
      "@trpc/client": "^11.19.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev:bare -F web --",
    "db:generate": "turbo run db:generate -F @delisert.mks-1/db --",
    "deploy": "turbo run deploy -F @delisert.mks-1/infra --",
    "destroy": "turbo run destroy -F @delisert.mks-1/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "dev:infra": "cd packages/infra && env -u npm_execpath -u npm_config_user_agent node node_modules/alchemy/bin/cli.js dev"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@delisert.mks-1/config": "workspace:*",
    "@types/node": "^26.4.1",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
