# @import(../../apps/web/, pick=[NODE_ENV])
# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Kata sandi tunggal untuk dashboard admin.
# @required
ADMIN_PASSWORD=

# Rahasia HMAC untuk menandatangani token sesi admin (minimal 32 karakter acak).
# @required
ADMIN_SESSION_SECRET=

# Supabase Storage untuk foto produk.
# Project URL, mis. https://abcdefgh.supabase.co
# @required
SUPABASE_URL=

# Service role key Supabase. Hanya dipakai di server; jangan diekspos ke klien.
# @required
SUPABASE_SERVICE_ROLE_KEY=

# Nama bucket foto. Bucket harus diset public agar foto bisa ditampilkan.
SUPABASE_BUCKET=products
